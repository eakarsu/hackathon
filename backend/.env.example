# Server-side only. Never expose these variables in browser code.
AI_CLIENT_ID=
AI_CLIENT_SECRET=
AI_TOKEN_URL=
AI_CHAT_URL=
AI_MODEL=gpt-4o

# Optional path to an internal CA bundle. Leave blank to use system trust.
AI_CA_BUNDLE=

# Local server boundary.
FLASK_HOST=127.0.0.1
FLASK_DEBUG=false
PORT=5001
CORS_ORIGINS=http://localhost:3000

# Request-supplied JSON/TXT paths are constrained beneath this directory.
DATA_ROOT=..
PERSIST_DIR=./chromadb_store
